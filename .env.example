# Copy to .env.local and fill in. Never commit real values.

# Public site URL (used for metadata, sitemap and OG images).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (required for the contact form) ─────────────────────────────
# Dashboard → Project Settings → API.
SUPABASE_URL=https://your-project-ref.supabase.co
# Secret key (sb_secret_…) or the legacy service_role key. SERVER-ONLY — never expose to the browser.
SUPABASE_SECRET_KEY=
# Publishable key (sb_publishable_…) or the legacy anon key. Used for admin sign-in; queries run as the
# signed-in user and are restricted by Row Level Security.
SUPABASE_PUBLISHABLE_KEY=

# ── Resend (optional: email notifications) ───────────────────────────────
# Leave RESEND_API_KEY empty to disable emails; submissions are still saved.
RESEND_API_KEY=
# Where new enquiries are sent.
CONTACT_TO_EMAIL=you@example.com
# Sender. Use "Name <onboarding@resend.dev>" for testing, or an address on a domain verified in Resend.
CONTACT_FROM_EMAIL=Eden <onboarding@resend.dev>
# Also email the sender a confirmation (requires a verified domain).
CONTACT_SEND_CONFIRMATION=false

# ── Security ─────────────────────────────────────────────────────────────
# Random string (32+ chars) used to hash IPs for rate limiting: `openssl rand -hex 32`
IP_HASH_SALT=
